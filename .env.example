# Copy to .env.local and fill in what you have. Every key is optional:
# MY GALA runs without any of them (rule-based styling + clearly labelled try-on demo mode).
# All keys are read on the server only and are never sent to the browser.

# Garment recognition (vision) and AI styling via Claude
ANTHROPIC_API_KEY=
# Optional override (default: claude-opus-5-5)
# MYGALA_CLAUDE_MODEL=claude-opus-5-5

# Virtual try-on — set ONE of these (checked in this order):
# FASHN (paid, most reliable)   → FASHN_API_KEY
# Hugging Face IDM-VTON (free)  → HF_TOKEN   (a free "read" token from huggingface.co/settings/tokens)
# Replicate (paid, text-guided) → REPLICATE_API_TOKEN
HF_TOKEN=
# FASHN (https://fashn.ai) — garment-image try-on
FASHN_API_KEY=
# Replicate (https://replicate.com) — powers photorealistic garment & campaign photos (flux-schnell)
# AND text-guided try-on on your photo (flux-kontext-pro). One token enables both.
REPLICATE_API_TOKEN=
# Optional: model used on Replicate (default black-forest-labs/flux-kontext-pro)
# REPLICATE_TRYON_MODEL=black-forest-labs/flux-kontext-pro

# Garment & model photos: generated by Replicate when REPLICATE_API_TOKEN is set; otherwise by the
# free Pollinations image service (no key, loaded directly by the browser).
